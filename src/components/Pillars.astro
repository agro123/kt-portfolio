---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import type { Content } from '../i18n';

interface Props {
  t: Content;
}
const { pillars } = Astro.props.t;
---

<section id="capabilities" class="py-20 sm:py-24">
  <div class="container-page">
    <SectionHeading eyebrow={pillars.eyebrow} title={pillars.title} intro={pillars.intro} />
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        pillars.items.map((item) => (
          <article class="card flex flex-col p-6 transition-colors hover:border-accent">
            <span class="grid size-11 place-items-center rounded-xl bg-accent-soft text-accent-text">
              <Icon name={item.icon} class="size-6" />
            </span>
            <h3 class="mt-5 font-display text-lg font-bold leading-snug text-ink">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{item.description}</p>
            <div class="mt-auto pt-5">
              <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-muted">{pillars.applicationsLabel}</p>
              <ul class="m-0 mt-2 list-none space-y-1.5 p-0">
                {item.applications.map((application) => (
                  <li class="flex gap-2 text-[13px] leading-snug text-ink">
                    <Icon name="check" class="mt-0.5 size-3.5 text-accent-text" />
                    {application}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
