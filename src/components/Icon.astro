---
// Single source for UI, biomedical-domain and profile icons (inline SVG, no external requests).
interface Props {
  name: string;
  class?: string;
}

type IconDef = { body: string; viewBox?: string; filled?: boolean };

const icons: Record<string, IconDef> = {
  // — UI —
  sun: { body: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>' },
  moon: { body: '<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/>' },
  menu: { body: '<path d="M4 7h16M4 12h16M4 17h16"/>' },
  close: { body: '<path d="M6 6l12 12M18 6L6 18"/>' },
  download: { body: '<path d="M12 4v11M7 11l5 5 5-5M5 20h14"/>' },
  'arrow-right': { body: '<path d="M5 12h14M13 6l6 6-6 6"/>' },
  'arrow-up': { body: '<path d="M12 19V5M6 11l6-6 6 6"/>' },
  copy: { body: '<rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/>' },
  check: { body: '<path d="M5 12.5l4.5 4.5L19 7.5"/>' },
  mail: { body: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>' },
  lock: { body: '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>' },
  pulse: { body: '<path d="M3 12h4l2.5-6 4 12 2.500-6H21"/>' },
  patent: { body: '<circle cx="12" cy="9" r="5"/><path d="M9 13.500 8 21l4-2 4 2-1-7.500"/>' },
  // — Biomedical domains —
  biomarker: { body: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>' },
  assay: { body: '<path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.800 3h10.400a2 2 0 0 0 1.800-3l-5-9V3"/><path d="M7.500 15h9"/>' },
  omics: { body: '<path d="M7 3c0 5 10 5 10 9s-10 4-10 9"/><path d="M17 3c0 5-10 5-10 9s10 4 10 9"/><path d="M8.500 6h7M8.500 18h7"/>' },
  leadership: { body: '<circle cx="12" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="19" cy="19" r="2"/><path d="M12 7v5M12 12l-5.500 5.200M12 12l5.500 5.200"/>' },
  microscope: { body: '<path d="M9.500 3l4 1.200-2.400 8.300-4-1.200z"/><path d="M6 21h12M12 21v-3M8 18h7.500a5 5 0 0 0 .5-10h-1.300"/>' },
  chart: { body: '<path d="M4 20h16M7 20v-6M12 20V8M17 20v-9"/>' },
  shield: { body: '<path d="M12 3l7 3v5c0 5-3 8.500-7 10-4-1.500-7-5-7-10V6z"/><path d="M9 12l2 2 4-4"/>' },
  briefcase: { body: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M3 13h18"/>' },
  consulting: { body: '<path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-4 10.500c.700.700 1 1.500 1 2.500h6c0-1 .300-1.800 1-2.500A6 6 0 0 0 12 3z"/>' },
  consortium: { body: '<circle cx="8" cy="9" r="4"/><circle cx="16" cy="9" r="4"/><circle cx="12" cy="15" r="4"/>' },
  // — Scientific profiles —
  orcid: { body: '<circle cx="12" cy="12" r="9"/><path d="M8.500 10v6.500M8.500 7.400v.100"/><path d="M11.800 10v6.500h1.900a3.250 3.250 0 0 0 0-6.500z"/>' },
  scholar: { body: '<path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11.500V16c0 1.500 2.700 3 6 3s6-1.500 6-3v-4.500M22 9v6"/>' },
  pubmed: { body: '<path d="M12 6c-2-1.500-5-2-8-1.500v13c3-.5 6 0 8 1.500 2-1.500 5-2 8-1.500v-13c-3-.5-6 0-8 1.500z"/><path d="M12 6v13"/>' },
  linkedin: { body: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10.500v6M8 7.400v.100M12 16.500v-6M12 13a2.500 2.500 0 0 1 5 0v3.500"/>' },
  github: {
    viewBox: '0 0 16 16',
    filled: true,
    body: '<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.230.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.530-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>',
  },
};

const { name, class: className = 'size-5' } = Astro.props;
const icon = icons[name] ?? icons.biomarker;
---

<svg
  viewBox={icon.viewBox ?? '0 0 24 24'}
  class:list={['shrink-0', className]}
  fill={icon.filled ? 'currentColor' : 'none'}
  stroke={icon.filled ? 'none' : 'currentColor'}
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icon.body}
/>
