---
import SectionHeading from './SectionHeading.astro';
import type { Content } from '../i18n';

interface Props {
  t: Content;
}
const { career } = Astro.props.t;
---

<section id="career" class="border-y border-line bg-surface py-20 sm:py-24">
  <div class="container-page">
    <SectionHeading eyebrow={career.eyebrow} title={career.title} />
    <div class="mt-12 grid gap-12 lg:grid-cols-[1.6fr_1fr]">
      <div>
        <h3 class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">{career.experienceTitle}</h3>
        <ol class="m-0 mt-5 list-none border-l border-line p-0">
          {
            career.items.map((item) => (
              <li class="relative pb-8 pl-6 last:pb-0">
                <span class="absolute -left-[5px] top-1.5 size-[9px] rounded-full border-2 border-accent bg-surface-solid" aria-hidden="true" />
                <p class="font-mono text-xs text-accent-text">{item.period}</p>
                <p class="mt-1 font-display text-lg font-bold leading-snug text-ink">{item.role}</p>
                <p class="text-sm font-medium text-muted">{item.org}</p>
                <p class="mt-2 max-w-xl text-sm leading-relaxed text-muted">{item.summary}</p>
              </li>
            ))
          }
        </ol>
      </div>
      <div>
        <h3 class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">{career.educationTitle}</h3>
        <ul class="m-0 mt-5 list-none space-y-3 p-0">
          {
            career.education.map((item) => (
              <li class="flex gap-4 rounded-2xl border border-line bg-bg p-4">
                <span class="font-mono text-sm font-semibold text-accent-text">{item.year}</span>
                <span>
                  <span class="block text-sm font-semibold leading-snug text-ink">{item.degree}</span>
                  <span class="block text-sm text-muted">{item.org}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
