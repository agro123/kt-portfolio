---
import Icon from './Icon.astro';
import MolecularPattern from './MolecularPattern.astro';
import SectionHeading from './SectionHeading.astro';
import { url, type Content } from '../i18n';

interface Props {
  t: Content;
}
const { cv, contact, site, ui } = Astro.props.t;
const { form } = contact;
// Without a form endpoint the form degrades to the visitor's email client.
const hasEndpoint = Boolean(form.endpoint);
---

<section id="cv" class="border-t border-line bg-surface py-20 sm:py-24">
  <div class="container-page">
    <SectionHeading eyebrow={cv.eyebrow} title={cv.title} />
    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {
        cv.items.map((item) => (
          <a
            href={url(item.file)}
            download
            class="group flex items-start gap-5 rounded-2xl border border-line bg-bg p-6 transition-colors hover:border-accent"
          >
            <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-accent-soft text-accent-text">
              <Icon name={item.icon} class="size-6" />
            </span>
            <span class="flex-1">
              <span class="block font-display text-lg font-bold text-ink">{item.title}</span>
              <span class="mt-1 block text-sm leading-relaxed text-muted">{item.description}</span>
              <span class="mt-4 flex flex-wrap items-center justify-between gap-3">
                <span class="font-mono text-[11px] text-muted">{item.meta}</span>
                <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent-text group-hover:underline">
                  <Icon name="download" class="size-4" />
                  {item.cta}
                </span>
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<section id="contact" class="relative overflow-hidden border-t border-line py-20 sm:py-24">
  <MolecularPattern
    id="contact-lattice"
    class="inset-0 opacity-60 [mask-image:radial-gradient(50%_60%_at_10%_90%,black,transparent)]"
  />
  <div class="container-page relative grid gap-12 lg:grid-cols-2 lg:gap-16">
    <div>
      <SectionHeading eyebrow={contact.eyebrow} title={contact.title} intro={contact.intro} />

      <p class="mt-10 font-mono text-[11px] uppercase tracking-[0.16em] text-muted">{contact.availabilityLabel}</p>
      <ul class="m-0 mt-4 list-none space-y-3 p-0">
        {
          contact.availability.map((item) => (
            <li class="card flex gap-4 p-4">
              <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-accent-soft text-accent-text">
                <Icon name={item.icon} class="size-5" />
              </span>
              <span>
                <span class="block text-sm font-semibold text-ink">{item.title}</span>
                <span class="mt-0.5 block text-sm leading-relaxed text-muted">{item.description}</span>
              </span>
            </li>
          ))
        }
      </ul>

      <div class="mt-8">
        <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">{contact.emailLabel}</p>
        <div class="mt-3 flex flex-wrap items-center gap-3">
          <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 break-all font-mono text-base font-medium text-ink hover:text-accent-text">
            <Icon name="mail" class="size-5 text-accent-text" />
            {site.email}
          </a>
          <button type="button" class="chip inline-flex items-center gap-1.5" data-copy={site.email} data-copied-label={ui.copied}>
            <Icon name="copy" class="size-3.5" />
            <span data-copy-label aria-live="polite">{ui.copyEmail}</span>
          </button>
        </div>
      </div>
    </div>

    <form
      class="card h-fit bg-surface-solid p-6 sm:p-8"
      action={hasEndpoint ? form.endpoint : `mailto:${site.email}`}
      method="post"
      enctype={hasEndpoint ? undefined : 'text/plain'}
      data-ajax-form={hasEndpoint ? '' : undefined}
    >
      <h3 class="font-display text-lg font-bold text-ink">{form.title}</h3>
      {form.accessKey && <input type="hidden" name="access_key" value={form.accessKey} />}
      <input type="hidden" name="subject" value={`${form.title} — ${site.name}`} />
      <div class="hidden" aria-hidden="true">
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
        <input type="checkbox" name="botcheck" tabindex="-1" />
      </div>

      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <label class="block text-sm font-medium text-ink">
          {form.name}
          <input class="field mt-1.5" type="text" name="name" autocomplete="name" required />
        </label>
        <label class="block text-sm font-medium text-ink">
          {form.email}
          <input class="field mt-1.5" type="email" name="email" autocomplete="email" required />
        </label>
        <label class="block text-sm font-medium text-ink">
          {form.organization}
          <input class="field mt-1.5" type="text" name="organization" autocomplete="organization" />
        </label>
        <label class="block text-sm font-medium text-ink">
          {form.topic}
          <select class="field mt-1.5" name="topic">
            {form.topics.map((topic) => <option value={topic}>{topic}</option>)}
          </select>
        </label>
        <label class="block text-sm font-medium text-ink sm:col-span-2">
          {form.message}
          <textarea class="field mt-1.5" name="message" rows="5" placeholder={form.messagePlaceholder} required></textarea>
        </label>
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-4">
        <button type="submit" class="btn btn-primary cursor-pointer disabled:opacity-60" data-sending-label={form.sending}>
          <span data-submit-label>{form.submit}</span>
          <Icon name="arrow-right" class="size-4" />
        </button>
        <p class="text-xs text-muted">{form.privacy}</p>
      </div>
      <div aria-live="polite">
        <p class="mt-4 rounded-xl border border-accent bg-accent-soft px-4 py-3 text-sm text-ink" data-form-success hidden>{form.success}</p>
        <p class="mt-4 rounded-xl border border-red-400 bg-red-500/10 px-4 py-3 text-sm text-ink" data-form-error hidden>{form.error}</p>
      </div>
    </form>
  </div>
</section>
