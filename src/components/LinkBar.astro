---
// Uniform reference/action bar. Every slot is always rendered so rows align;
// slots without a URL are shown as unavailable.
import { url } from '../i18n';

interface Props {
  links: Record<string, string>;
  order: string[];
  labels: Record<string, string>;
  unavailable: string;
  context: string;
}
const { links, order, labels, unavailable, context } = Astro.props;
---

<ul class="m-0 flex list-none flex-wrap items-center gap-x-3 gap-y-1 p-0">
  {
    order.map((key) => {
      const href = links[key];
      return (
        <li>
          {href ? (
            <a class="ref-link" href={url(href)} target="_blank" rel="noopener noreferrer" aria-label={`${labels[key]} — ${context}`}>
              {labels[key]}
            </a>
          ) : (
            <span class="ref-link" aria-disabled="true" title={`${labels[key]}: ${unavailable}`}>
              {labels[key]}
            </span>
          )}
        </li>
      );
    })
  }
</ul>
