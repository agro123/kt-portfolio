---
// Reusable scientific workflow diagram ("graphical abstract").
// Each step picks a glyph from the library below; labels come from the JSON data.
interface Step {
  glyph: string;
  label: string;
}
interface Props {
  steps: Step[];
  label: string;
}

// Glyphs are drawn on a 48×48 grid.
const glyphs: Record<string, string> = {
  sample: '<path d="M18 8h12M20 8v25a4 4 0 0 0 8 0V8"/><path d="M20 22h8"/><circle cx="24" cy="30" r="1.2"/>',
  dna: '<path d="M16 6c0 11 16 11 16 18S16 31 16 42"/><path d="M32 6c0 11-16 11-16 18s16 7 16 18"/><path d="M19 12h10M19 36h10M21.500 24h5"/>',
  plate: '<rect x="7" y="12" width="34" height="24" rx="3"/><circle cx="15" cy="20" r="2"/><circle cx="24" cy="20" r="2"/><circle cx="33" cy="20" r="2"/><circle cx="15" cy="29" r="2"/><circle cx="24" cy="29" r="2" fill="currentColor"/><circle cx="33" cy="29" r="2"/>',
  chart: '<path d="M9 39h30M9 39V9"/><path d="M16 39V27M24 39V17M32 39V22"/><path d="M14 20l8-7 6 4 8-8"/>',
  cell: '<circle cx="24" cy="24" r="15"/><circle cx="21" cy="22" r="5"/><circle cx="31" cy="30" r="1.500"/><circle cx="30" cy="18" r="1.200"/>',
  molecule: '<path d="M24 9l9 5v10l-9 5-9-5V14z"/><path d="M33 24l6 4M15 24l-6 4M24 29v9"/><circle cx="40" cy="29" r="2"/><circle cx="8" cy="29" r="2"/><circle cx="24" cy="40" r="2"/>',
  network: '<circle cx="24" cy="10" r="3"/><circle cx="10" cy="24" r="3"/><circle cx="38" cy="24" r="3"/><circle cx="16" cy="38" r="3"/><circle cx="32" cy="38" r="3"/><path d="M22 12 12 22M26 12l10 10M11 27l4 8M37 27l-4 8M19 38h10M13 24h22"/>',
  target: '<circle cx="24" cy="24" r="15"/><circle cx="24" cy="24" r="8"/><circle cx="24" cy="24" r="2" fill="currentColor"/><path d="M24 5v6M24 37v6M5 24h6M37 24h6"/>',
  shield: '<path d="M24 6l14 6v10c0 10-6 17-14 20-8-3-14-10-14-20V12z"/><path d="M17.500 24l4.500 4.500 8.500-9"/>',
  clinic: '<rect x="8" y="8" width="32" height="32" rx="6"/><path d="M24 16v16M16 24h16"/>',
  organoid: '<circle cx="19" cy="19" r="7"/><circle cx="31" cy="21" r="6"/><circle cx="24" cy="31" r="7"/><circle cx="19" cy="19" r="1.500" fill="currentColor"/><circle cx="24" cy="31" r="1.500" fill="currentColor"/>',
  chip: '<rect x="13" y="13" width="22" height="22" rx="3"/><path d="M19 21l-3 3 3 3M29 21l3 3-3 3M25.500 19l-3 10"/><path d="M18 13V8M24 13V8M30 13V8M18 40v-5M24 40v-5M30 40v-5M13 18H8M13 30H8M40 18h-5M40 30h-5"/>',
};

const { steps, label } = Astro.props;
const n = Math.max(steps.length, 1);
const cell = 120;
const width = cell * n;
const box = 68;
---

<figure class="m-0">
  <svg viewBox={`0 0 ${width} 92`} class="h-auto w-full" role="img" aria-label={`${label}: ${steps.map((s) => s.label).join(' → ')}`}>
    {
      steps.map((step, i) => {
        const cx = cell * i + cell / 2;
        const last = i === steps.length - 1;
        return (
          <g>
            {!last && (
              <g stroke="var(--accent)" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path d={`M${cx + box / 2 + 7} 46h${cell - box - 16}`} stroke-dasharray="2 5" />
                <path d={`M${cx + cell - box / 2 - 13} 41l5 5-5 5`} />
              </g>
            )}
            <rect
              x={cx - box / 2}
              y={12}
              width={box}
              height={box}
              rx="16"
              fill={last ? 'var(--accent-soft)' : 'var(--surface)'}
              stroke={last ? 'var(--accent)' : 'var(--line)'}
              stroke-width="1.2"
            />
            <g
              transform={`translate(${cx - 24} 22)`}
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              style={`color: var(${last ? '--accent-text' : '--ink'})`}
              set:html={glyphs[step.glyph] ?? glyphs.target}
            />
          </g>
        );
      })
    }
  </svg>
  <ol class="mt-2 grid list-none gap-1 p-0" style={`grid-template-columns: repeat(${n}, minmax(0, 1fr))`}>
    {
      steps.map((step, i) => (
        <li class="px-1 text-center text-[11px] leading-snug text-muted">
          <span class="block font-mono text-[10px] text-accent-text">{String(i + 1).padStart(2, '0')}</span>
          {step.label}
        </li>
      ))
    }
  </ol>
</figure>
